+    public function senhas(Request $request): JsonResponse
+    {
+        $ponto = session('pos_localizacao') ?: session('pos_nome');
+        $numero = (int) $request->query('numero');
+
+        $pedidos = Pedido::where('tipo', 'bar_prepago')
