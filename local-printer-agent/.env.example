APP_URL=https://ardcsantana.ateneya.com
PRINT_AGENT_TOKEN=trocar-por-token-seguro
POLL_SECONDS=3
PRINT_DELAY_MS=200
PRINT_CODEPAGE=cp860

# Nome deste posto. Tem de ser igual ao campo "Posto (agente)" das impressoras
# no backoffice. Com varios pontos de pre-pagamento, cada computador so vai
# buscar os trabalhos das impressoras dele. Em branco, o agente so leva as
# impressoras que nao tenham posto atribuido.
AGENTE=caixa-1
